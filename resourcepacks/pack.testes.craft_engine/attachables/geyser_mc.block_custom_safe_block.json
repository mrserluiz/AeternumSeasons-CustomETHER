{
  "format_version": "1.21.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "geyser_mc:block/custom/safe_block",
      "materials": {
        "enchanted": "entity_alphatest_glint",
        "default": "entity_alphatest"
      },
      "textures": {
        "enchanted": "textures/misc/enchanted_item_glint",
        "default": "textures/block/custom/safe_block_stitched"
      },
      "geometry": {
        "default": "geometry.geyser_mc.block_custom_topaz_ore"
      },
      "animations": {
        "first_person": "animation.geyser_mc.block_custom_safe_block.hold_first_person",
        "head": "animation.geyser_mc.block_custom_safe_block.head",
        "third_person": "animation.geyser_mc.block_custom_safe_block.hold_third_person"
      },
      "scripts": {
        "animate": [
          {
            "first_person": "context.is_first_person == 1.0 && (context.item_slot == 'main_hand' || context.item_slot == 'off_hand')"
          },
          {
            "third_person": "context.is_first_person == 0.0 && (context.item_slot == 'main_hand' || context.item_slot == 'off_hand')"
          },
          {
            "head": "context.is_first_person == 0.0 && context.item_slot == 'head'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}