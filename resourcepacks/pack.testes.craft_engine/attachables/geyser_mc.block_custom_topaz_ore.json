{
  "format_version": "1.21.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "geyser_mc:block/custom/topaz_ore",
      "materials": {
        "enchanted": "entity_alphatest_glint",
        "default": "entity_alphatest"
      },
      "textures": {
        "frame_0": "textures/block/custom/topaz_ore_0",
        "frame_1": "textures/block/custom/topaz_ore_1",
        "frame_2": "textures/block/custom/topaz_ore_2",
        "frame_3": "textures/block/custom/topaz_ore_3",
        "frame_4": "textures/block/custom/topaz_ore_4",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.geyser_mc.block_custom_topaz_ore"
      },
      "animations": {
        "first_person": "animation.geyser_mc.block_custom_topaz_ore.hold_first_person",
        "head": "animation.geyser_mc.block_custom_topaz_ore.head",
        "third_person": "animation.geyser_mc.block_custom_topaz_ore.hold_third_person"
      },
      "scripts": {
        "animate": [
          {
            "first_person": "context.is_first_person == 1.0 && (context.item_slot == 'main_hand' || context.item_slot == 'off_hand')"
          },
          {
            "third_person": "context.is_first_person == 0.0 && (context.item_slot == 'main_hand' || context.item_slot == 'off_hand')"
          },
          {
            "head": "context.is_first_person == 0.0 && context.item_slot == 'head'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.minecraft.block_custom_topaz_ore"
      ]
    }
  }
}